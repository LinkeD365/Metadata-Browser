{
  "name": "@linked365/pptb-metadata-browser",
  "version": "0.5.1",
  "displayName": "Metadata Browser",
  "description": "Dataverse Metadata browser",
  "main": "index.html",
  "author": "LinkeD365",
  "icon": "metaDataBrowserLogo.svg",
  "repository": {
    "url": "https://github.com/LinkeD365/Metadata-Browser",
    "type": "git"
  },
  "features": {
    "connections": {
      "min": 1,
      "max": 2
    },
    "minAPI": "1.2.7"
  },
  "homepage": "https://github.com/LinkeD365/Metadata-Browser#readme",
  "bugs": {
    "url": "https://github.com/LinkeD365/Metadata-Browser/issues"
  },
  "contributors": [
    {
      "name": "LinkeD365",
      "url": "https://github.com/LinkeD365"
    }
  ],
  "license": "MIT",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "configurations": {
    "repository": "https://github.com/LinkeD365/Metadata-Browser",
    "website": "https://linked365.blog",
    "readmeUrl": "https://raw.githubusercontent.com/LinkeD365/Metadata-Browser/refs/heads/master/README.md"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.7",
    "@fluentui/react-icons": "^2.0.315",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "exceljs": "^4.4.0",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-json-pretty": "^2.2.0"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^7.1.11",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "IMPLEMENTATION.MD"
  ]
}
